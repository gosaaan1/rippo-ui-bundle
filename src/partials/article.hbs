<article class="doc{{#if (eq (or page.attributes.role page.role) 'post')}} rippo-post{{/if}}">
{{#if (eq (or page.attributes.role page.role) 'post')}}
{{> rippo-post-header}}
{{/if}}
{{#with page.title}}
<h1 class="page">{{{this}}}</h1>
{{/with}}
{{{page.contents}}}
{{#if (eq page.layout 'home')}}
{{> rippo-home-recent}}
{{/if}}
{{#if (eq page.layout 'timeline')}}
{{> rippo-timeline-list}}
{{/if}}
{{#if (eq page.layout 'tags')}}
{{> rippo-tags-list}}
{{/if}}
{{#if (eq (or page.attributes.role page.role) 'post')}}
{{> rippo-post-footer}}
{{/if}}
{{> pagination}}
</article>
